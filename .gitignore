# Predictions, resamples and caches (rebuilt by the stages that write them)
artifacts/**/*.npz
artifacts/**/*.npy
artifacts/**/work/
artifacts/final_rerun/
artifacts/final_dryrun/
artifacts/dryrun/
artifacts/rerun/
